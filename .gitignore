# Open 3D per-session sidecars (<layout>.open3d.json): the inspector's measurements,
# hidden items, overlay toggles and camera saved next to a layout. User/workstation
# data that travels with the layout (Filen), not source -- keep it out of git.
*.open3d.json

# Local UI attachments, screenshots, and imported CAD are user/workstation data.
# Keep curated catalogs and Zemax prescriptions explicit in git.
/attachment/*.png
/attachment/*.py
/attachment/*.step
/attachment/*.STEP
/attachment/__pycache__/
# Filen sync bookkeeping: local trash plus the sync-exclusion config. Filen's
# domain -- it syncs these itself; keep them out of git.
/attachment/.filen.trash.local/
/attachment/.filenignore
# bugs/0021: generated CAD/STEP mesh cache. Lives under attachment/ so the user
# syncs it (Filen) and a layout opened on another machine finds its body mesh,
# but it is a derived artefact -- keep it out of git.
/attachment/cad_cache/
/attachment/Cameras/
/attachment/LED/
/attachment/Lens/
/attachment/68551/
/attachment/machine_vision_150mm_measured_3d.step
/attachment/prisms/**/*.png
/attachment/prisms/**/*.PNG
/attachment/prisms/**/*.eprt
/attachment/prisms/**/*.EPRT
/attachment/prisms/**/*.igs
/attachment/prisms/**/*.IGS
/attachment/prisms/**/*.iges
/attachment/prisms/**/*.IGES
/attachment/prisms/**/*.pdf
/attachment/prisms/**/*.PDF
/attachment/prisms/**/*.step
/attachment/prisms/**/*.STEP
!/attachment/prisms/32336/step_32336.step
!/attachment/prisms/42779/step_42779.step

# Zemax collections (Sequential/, Short course/, ...): the Examples menu reads
# only the .zmx text prescriptions, which we keep explicit in git. The bulky
# OpticStudio session/data/ray binaries (.zos/.zda/.zrd, ~190 MB) and the
# per-config sidecars (.cfg/.zpl/.xml) are not parsed by KrakenOS -- keep them
# local so the repo stays lean.
/attachment/zemax/**/*.zos
/attachment/zemax/**/*.ZOS
/attachment/zemax/**/*.zda
/attachment/zemax/**/*.ZDA
/attachment/zemax/**/*.zrd
/attachment/zemax/**/*.ZRD
/attachment/zemax/**/*.cfg
/attachment/zemax/**/*.CFG
/attachment/zemax/**/*.zpl
/attachment/zemax/**/*.ZPL
/attachment/zemax/**/*.xml
/attachment/zemax/**/*.XML

