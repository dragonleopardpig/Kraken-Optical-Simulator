#!/usr/bin/env bash

# Inherit Node.js/npm from parent Projects folder
source_up

export DIRENV_WARN_TIMEOUT=20s
export DEVENV_SKIP_UPDATE_CHECK=1

# Bootstrap use_devenv if needed
if ! has use_devenv; then
  if [[ -x /run/current-system/sw/bin/devenv ]]; then
    eval "$(/run/current-system/sw/bin/devenv direnvrc)"
  else
    eval "$(devenv direnvrc 2>/dev/null)"
  fi
fi

use devenv

if [[ -d .devenv/state/venv/bin ]]; then
  PATH_add .devenv/state/venv/bin
fi
