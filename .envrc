#!/usr/bin/env bash

export DIRENV_WARN_TIMEOUT=20s
export DEVENV_SKIP_UPDATE_CHECK=1

_kraken_cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
if [[ ! -d "$_kraken_cache_home" ]]; then
  mkdir -p "$_kraken_cache_home" 2>/dev/null || true
fi
if [[ ! -w "$_kraken_cache_home" ]]; then
  export XDG_CACHE_HOME="$PWD/.devenv/state/cache"
  mkdir -p "$XDG_CACHE_HOME"
fi
unset _kraken_cache_home

if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -w "${XDG_RUNTIME_DIR:-}" ]]; then
  export XDG_RUNTIME_DIR="$PWD/.devenv/state/runtime"
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

# Bootstrap use_devenv if needed
if ! has use_devenv; then
  if [[ -x /run/current-system/sw/bin/devenv ]]; then
    eval "$(/run/current-system/sw/bin/devenv direnvrc)"
  else
    eval "$(devenv direnvrc 2>/dev/null)"
  fi
fi

use devenv

if [[ -d .devenv/state/venv/bin ]]; then
  PATH_add .devenv/state/venv/bin
fi
